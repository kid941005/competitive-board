# ⚠️ 只给 deploy/ 里的「新闻动态流」规划稿用，**看板本体不需要 .env**。
#    主线部署（仓库根目录的 docker-compose.yml）所有配置都以字面值写在 compose 里。
#
# 复制为 .env 后修改。所有带 :? 的变量必须填写，否则 compose 会直接报错退出。

# 时区
TZ=Asia/Shanghai

# ── PostgreSQL ──
POSTGRES_DB=ciboard
POSTGRES_USER=ciboard
# 必须改。生成方式：openssl rand -base64 24
POSTGRES_PASSWORD=

# ── changedetection.io ──
CDIO_USER=admin
CDIO_PASS=
CDIO_PORT=5000
CDIO_BASE_URL=http://127.0.0.1:5000

# ── 端口（均只绑 127.0.0.1）──
RSSHUB_PORT=1200
API_PORT=8000

# ── 抓取并发 ──
# 每开一个 Chromium 约 300~500MB 常驻内存，按机器内存调整
MAX_CHROME=2

# ── 自建 API ──
# 任意 OpenAI 兼容端点即可（DeepSeek / 智谱 / Ollama / vLLM）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
PUBLIC_API_BASE=/api
