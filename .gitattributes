# 统一换行符：容器内的 bash 脚本必须是 LF，否则会报 exec format error / $'\r': command not found
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf

# Windows 专用脚本保留 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.pdf binary
