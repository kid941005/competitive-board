# 复制为 .env 后按需修改。只有启用 PostgreSQL 时才必须填 POSTGRES_PASSWORD。

# ── 镜像 ──
# 默认固定到具体版本，避免 latest 悄无声息地升级；要跟最新就填 latest
CIB_IMAGE_TAG=0.9.2

# ── 应用 ──
# 宿主端口（只绑 127.0.0.1）
APP_PORT=8000
# 容器运行身份。默认 10001 与镜像内 appuser 一致。
# 数据目录属主是别的 uid 时（NAS 共享目录常见），设成那个 uid，就不必 chown 目录。
# 例：CIB_UID=1000 / CIB_GID=1000；或 CIB_UID=0 / CIB_GID=0 以 root 运行。
CIB_UID=10001
CIB_GID=10001
# 首次启动是否写入示例数据。默认 0 = 空库启动（只有表结构和管理员账号）。
# 想要压电领域的示例公司/型号，设为 1；只想要指标字典，用「系统设置」里的
# 「应用内置压电指标模板」，或在容器内跑 python -m app.seed --metrics-only
CIB_SEED_DEMO=0
# 单页最多对比型号数（运行时可在「系统设置」里改，此处仅作初始默认）
CIB_MAX_COMPARE=8
# 未入库规格书原文的保留天数（被参数引用的不受影响；运行时可在「系统设置」里改）
CIB_DATASHEET_DAYS=30
TZ=Asia/Shanghai

# ── 初始管理员 ──
# 仅当库里一个管理员都没有时生效。密码需 ≥10 位且含字母与数字。
# 留空则自动生成随机密码并打印到容器日志：
#   docker compose logs app | grep 初始密码
CIB_ADMIN_USER=admin
CIB_ADMIN_PASSWORD=

# ── 会话 ──
# HTTPS 部署时必须置 1，否则会话 Cookie 会在明文链路上传输
CIB_COOKIE_SECURE=0
# 会话有效期（小时）。运行时可在「系统设置」里改。
CIB_SESSION_HOURS=12

# ── PostgreSQL（仅 docker-compose.pg.yml 需要）──
POSTGRES_DB=ciboard
POSTGRES_USER=ciboard
# 必填。生成：openssl rand -base64 24
POSTGRES_PASSWORD=
