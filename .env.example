# 复制为 .env 后按需修改。只有启用 PostgreSQL 时才必须填 POSTGRES_PASSWORD。

# ── 应用 ──
# 宿主端口（只绑 127.0.0.1）
APP_PORT=8000
# 首次启动是否写入示例数据（1=写入，0=空库启动）
CIB_SEED_DEMO=1
# 单页最多对比型号数
CIB_MAX_COMPARE=8
TZ=Asia/Shanghai

# ── PostgreSQL（仅 docker-compose.pg.yml 需要）──
POSTGRES_DB=ciboard
POSTGRES_USER=ciboard
# 必填。生成：openssl rand -base64 24
POSTGRES_PASSWORD=
